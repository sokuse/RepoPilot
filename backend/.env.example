REPOPILOT_ENVIRONMENT=development
REPOPILOT_API_V1_PREFIX=/api/v1
REPOPILOT_CORS_ORIGINS=["http://localhost:5173"]
REPOPILOT_DATABASE_URL=sqlite:///./repopilot.db
REPOPILOT_REPOSITORY_STORAGE_PATH=./data/repositories
REPOPILOT_GIT_CLONE_TIMEOUT_SECONDS=300
REPOPILOT_GIT_CLONE_ATTEMPTS=3
REPOPILOT_GIT_RETRY_BASE_DELAY_SECONDS=1
# 如果 GitHub 需要经过本地代理，取消下一行注释并填写代理地址。
# REPOPILOT_GIT_PROXY_URL=http://127.0.0.1:7890
REPOPILOT_MAX_SCANNED_FILE_SIZE_BYTES=1000000
REPOPILOT_CHUNK_SIZE_CHARS=1500
REPOPILOT_CHUNK_OVERLAP_CHARS=200
