REPOPILOT_ENVIRONMENT=development
REPOPILOT_API_V1_PREFIX=/api/v1
REPOPILOT_CORS_ORIGINS=["http://localhost:5173"]
REPOPILOT_DATABASE_URL=sqlite:///./repopilot.db
REPOPILOT_REPOSITORY_STORAGE_PATH=./data/repositories
REPOPILOT_GIT_CLONE_TIMEOUT_SECONDS=300
REPOPILOT_GIT_CLONE_ATTEMPTS=3
REPOPILOT_GIT_RETRY_BASE_DELAY_SECONDS=1
# 如果 GitHub 需要经过本地代理，取消下一行注释并填写代理地址。
# REPOPILOT_GIT_PROXY_URL=http://127.0.0.1:7890
REPOPILOT_MAX_SCANNED_FILE_SIZE_BYTES=1000000
REPOPILOT_CHUNK_SIZE_CHARS=1500
REPOPILOT_CHUNK_OVERLAP_CHARS=200
# Docker 中会覆盖为 http://qdrant:6333；本地留空时继续使用下面的嵌入式目录。
# REPOPILOT_VECTOR_DATABASE_URL=http://127.0.0.1:6333
REPOPILOT_VECTOR_DATABASE_PATH=./data/qdrant
REPOPILOT_EMBEDDING_MODEL_NAME=text-embedding-v4
REPOPILOT_EMBEDDING_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Embedding 与聊天模型共用这个百炼 Qwen API Key。
# 只写入本地 backend/.env，绝对不要提交真实 API Key。
REPOPILOT_QWEN_API_KEY=输入你的API-KEY
REPOPILOT_EMBEDDING_DIMENSIONS=1024
REPOPILOT_VECTOR_COLLECTION_NAME=repopilot_chunks
REPOPILOT_MEMORY_VECTOR_COLLECTION_NAME=repopilot_memories
REPOPILOT_MEMORY_CHUNK_SIZE_CHARS=1000
REPOPILOT_MEMORY_CHUNK_OVERLAP_CHARS=100
REPOPILOT_MEMORY_RETRIEVAL_LIMIT=4
REPOPILOT_SHORT_TERM_MESSAGE_LIMIT=6
REPOPILOT_EMBEDDING_BATCH_SIZE=10
REPOPILOT_CHAT_MODEL_NAME=qwen-plus
REPOPILOT_RAG_RETRIEVAL_LIMIT=8
REPOPILOT_RAG_MAX_CONTEXT_CHARS=16000
REPOPILOT_RAG_TEMPERATURE=0.1
# MCP 默认由本地客户端通过 stdio 启动；部署为服务时可改为 streamable-http。
REPOPILOT_MCP_TRANSPORT=stdio
REPOPILOT_MCP_HOST=127.0.0.1
REPOPILOT_MCP_PORT=8001
REPOPILOT_MCP_API_BASE_URL=http://127.0.0.1:8000/api/v1
